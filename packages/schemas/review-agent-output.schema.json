{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cocode.local/schemas/review-agent-output.v1.schema.json",
  "title": "ReviewAgentOutputV1",
  "description": "Structured output emitted by a review agent before candidate normalization.",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "findings"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "review-agent-output/v1"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim",
        "category",
        "severity",
        "confidence",
        "locations",
        "evidence"
      ],
      "properties": {
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "$ref": "#/$defs/category"
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "locations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/location"
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "counter_evidence_request": {
          "type": "string",
          "description": "Describe the specific fact or code path that would disprove the finding. Do not present related guards, tests, or search hits as verified counter-evidence unless they directly refute the claim."
        },
        "suggested_fix": {
          "type": "string"
        },
        "draft_comment": {
          "type": "string"
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "start_line", "end_line", "side"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "side": {
          "type": "string",
          "enum": ["RIGHT", "LEFT", "UNKNOWN"]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "summary", "kind"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "$ref": "#/$defs/evidence_kind"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "category": {
      "type": "string",
      "enum": [
        "security",
        "correctness",
        "testing",
        "reliability",
        "data_integrity",
        "performance",
        "maintainability",
        "api",
        "docs",
        "style",
        "other"
      ]
    },
    "severity": {
      "type": "string",
      "enum": ["blocker", "high", "medium", "low", "nit"]
    },
    "evidence_kind": {
      "type": "string",
      "enum": [
        "changed_code",
        "related_code",
        "middleware",
        "guard",
        "handler",
        "test",
        "config",
        "counter_evidence",
        "missing_guard",
        "unknown"
      ]
    }
  }
}
