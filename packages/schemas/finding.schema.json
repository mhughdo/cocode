{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cocode.local/schemas/finding.schema.json",
  "title": "Finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "severity",
    "file_path",
    "line_start",
    "description"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info"
      ]
    },
    "file_path": {
      "type": "string",
      "minLength": 1
    },
    "line_start": {
      "type": "integer",
      "minimum": 1
    },
    "line_end": {
      "type": "integer",
      "minimum": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    }
  }
}
